# 平台
CONFIG_TARGET_ipq60xx=y
CONFIG_TARGET_ipq60xx_generic=y
CONFIG_TARGET_ipq60xx_generic_DEVICE_zn_m2=y

# 编译
CONFIG_CCACHE=y
CONFIG_DEVEL=y

# 基础路由必选
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_libipset=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y

# NSS 硬件加速（有线主路由必须留）
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_nss-eip-firmware=y

# 加密基础库
CONFIG_PACKAGE_libsodium=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_zlib=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_LIBCURL_OPENSSL=y
CONFIG_LIBSODIUM_MINIMAL=y

# curl 基础（PassWall & Lucky 必需）
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_libcurl=y
CONFIG_LIBCURL_COOKIES=y
CONFIG_LIBCURL_CRYPTH_AUTH=y
CONFIG_LIBCURL_FILE=y
CONFIG_LIBCURL_FTP=y
CONFIG_LIBCURL_HTTP=y
CONFIG_LIBCURL_NGHTTP2=y
CONFIG_LIBCURL_PROXY=y
CONFIG_LIBCURL_THREADED_RESOLVER=y
CONFIG_PACKAGE_libnghttp2=y
CONFIG_PACKAGE_ca-certificates=y

# DNS 净化（PassWall 必需）
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_pdnsd-alt=y
CONFIG_PACKAGE_resolveip=y

# PassWall 核心（只留高效核心，无冗余）
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=y

# 全部关闭 PassWall 多余代理
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan_Plus=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_tuic_client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=n

# Lucky（DDNS/反向代理/端口映射）
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-lucky=y

# UPnP
CONFIG_PACKAGE_miniupnpd=y
CONFIG_PACKAGE_luci-app-upnp=y

# ZeroTier
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y

# LuCI 基础 + 主题（只留一个主题）
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-design=n

# 只保留中文，删除所有多余语言包
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y

# 关闭所有其他插件
CONFIG_PACKAGE_openvpn-openssl=n
CONFIG_PACKAGE_wireguard-tools=n
CONFIG_PACKAGE_kmod-wireguard=n
CONFIG_PACKAGE_bash=n
CONFIG_PACKAGE_htop=n
CONFIG_PACKAGE_coremark=n
CONFIG_PACKAGE_stress-ng=n
CONFIG_PACKAGE_ttyd=n
CONFIG_PACKAGE_nps=n
CONFIG_PACKAGE_ddns-scripts=n
CONFIG_PACKAGE_ddns-scripts_aliyun=n
CONFIG_PACKAGE_ddns-scripts_dnspod=n
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_luci-app-autoreboot=n
CONFIG_PACKAGE_luci-app-arpbind=n
CONFIG_PACKAGE_luci-app-filetransfer=n
CONFIG_PACKAGE_etherwake=n
CONFIG_PACKAGE_wget-ssl=n
CONFIG_PACKAGE_unzip=n
CONFIG_PACKAGE_tcping=n
CONFIG_PACKAGE_microsocks=n
CONFIG_PACKAGE_ssocks=n
CONFIG_PACKAGE_simple-obfs-client=n
CONFIG_PACKAGE_proto-bonding=n
CONFIG_PACKAGE_luci-proto-bonding=n

# 多余内核模块关闭
CONFIG_PACKAGE_kmod-crypto-acompress=n
CONFIG_PACKAGE_kmod-crypto-cbc=n
CONFIG_PACKAGE_kmod-crypto-deflate=n
CONFIG_PACKAGE_kmod-crypto-des=n
CONFIG_PACKAGE_kmod-crypto-echainiv=n
CONFIG_PACKAGE_kmod-crypto-hmac=n
CONFIG_PACKAGE_kmod-crypto-iv=n
CONFIG_PACKAGE_kmod-crypto-md5=n
CONFIG_PACKAGE_kmod-crypto-rng=n
CONFIG_PACKAGE_kmod-crypto-sha1=n
CONFIG_PACKAGE_kmod-crypto-sha256=n
CONFIG_PACKAGE_kmod-crypto-wq=n
CONFIG_PACKAGE_kmod-inet-diag=n
CONFIG_PACKAGE_kmod-iptunnel6=n